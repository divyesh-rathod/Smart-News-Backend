# PostgreSQL connection string (adjust with your credentials and database name)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/your_database_name

# A secret key for your application (replace with a strong secret)

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=15

# Debug mode (True or False): echoes every SQL statement
DEBUG=True
LOG_LEVEL=INFO

# Shared secret for admin endpoints such as POST /api/V1/scripts/run_pipeline (sent as the X-Admin-Token
# header). Leave empty to disable them. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Cross-encoder runtime. MODEL_DEVICE: cpu, cuda or mps (Apple GPU). TORCH_NUM_THREADS: leave commented
# out for torch's default; on a 10-core Mac, 8 was about 10% faster than the default of 4.
MODEL_DEVICE=cpu
# TORCH_NUM_THREADS=8

# Per-process cache of each liked article's recommendations
RECOMMENDATION_CACHE_SIZE=256
RECOMMENDATION_CACHE_TTL_SECONDS=900

# The host and port come from the uvicorn command line, e.g. uvicorn app.main:app --port 8000
